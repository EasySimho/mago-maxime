---
import site from '../data/site.json';
import Photo from './Photo.astro';
const year = new Date().getFullYear();
---

<footer class="footer" id="fine">
  <div class="wrap">
    <!-- One last look at him, with the one thing left to do -->
    <div class="footer__card">
      <Photo name="saluto" mobile="saluto-telefono" alt={`${site.nome} al microfono, in scena davanti al pubblico`} position="60% 0%" />
      <div class="footer__over">
        <p class="footer__line">Ci vediamo<br /><em>alla prossima serata</em><span class="pip">.</span></p>
        <a href="#prenota" class="btn btn--ticket">
          Prenota
          <span class="btn__stub" aria-hidden="true">
            <svg class="btn__icon" viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </span>
        </a>
      </div>
    </div>

    <div class="footer__bottom">
      <ul class="footer__social">
        <li><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
        <li><a href={site.social.tiktok} target="_blank" rel="noopener">TikTok</a></li>
        <li><a href={site.social.youtube} target="_blank" rel="noopener">YouTube</a></li>
      </ul>
      <p class="label footer__legal">© {year} Mago {site.nome}</p>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; padding: clamp(64px, 10vw, 140px) 0 calc(var(--s-4) + env(safe-area-inset-bottom)); }

  .footer__card {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-panel);
    overflow: hidden;
    background: var(--panel);
  }
  .footer__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.92) 0%, rgba(5, 5, 5, 0.55) 30%, rgba(5, 5, 5, 0) 58%);
    pointer-events: none;
  }
  .footer__over {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    padding: clamp(24px, 4vw, 56px);
  }
  .footer__line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    font-weight: 500;
    font-stretch: 112%;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .footer__line em { font-weight: 250; }
  .footer__over .btn { min-width: 200px; justify-content: space-between; }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s-3);
    margin-top: var(--s-3);
  }
  .footer__legal { margin: 0; color: var(--ash); }
  .footer__social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 20px; }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ash);
    transition: color var(--d-1);
  }
  .footer__social a:hover { color: var(--chalk); }

  /* wide screens: the words on the stage at the left, the photo beside them */
  @media (min-width: 900px) {
    .footer__card {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: clamp(32px, 5vw, 72px);
      aspect-ratio: auto;
      border-radius: 0;
      overflow: visible;
      background: none;
    }
    .footer__card::after { content: none; }
    .footer__card :global(.photo) { grid-column: 2; grid-row: 1; aspect-ratio: 3 / 2; height: auto; border-radius: var(--r-panel); }
    .footer__over { position: static; grid-column: 1; grid-row: 1; padding: 0 0 var(--s-2); }
  }
  @media (max-width: 760px) {
    .footer__bottom { justify-content: center; text-align: center; }
  }
</style>
