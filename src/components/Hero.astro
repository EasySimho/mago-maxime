---
import fs from 'node:fs';
import path from 'node:path';
import site from '../data/site.json';
import Photo from './Photo.astro';

const reel = fs.existsSync(path.join(process.cwd(), 'public', 'maxime', 'showreel.mp4'));
const tel = `tel:${site.telefono.replace(/\s/g, '')}`;
const poster = ['jpg', 'jpeg', 'png', 'webp'].map((e) => `ritratto.${e}`).find((f) => fs.existsSync(path.join(process.cwd(), 'public', 'maxime', f)));
import { url } from '../scripts/url';
---

<section class="act act--hero" id="sipario" aria-labelledby="hero-title">
  <div class="act__panel hero">
    <figure class="hero__media">
      {
        reel ? (
          <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={poster ? url(`maxime/${poster}`) : undefined} aria-label={`${site.nome} in scena`}>
            <source src={url('maxime/showreel.mp4')} type="video/mp4" />
          </video>
        ) : (
          <Photo name="ritratto" alt={`Ritratto di ${site.nome}`} eager position="0% 50%" />
        )
      }
    </figure>

    <div class="hero__text">
      <h1 class="hero__name" id="hero-title"><span class="sr-only">Mago </span>{site.nome}</h1>
      <!-- The rule of the three M: each M in card red -->
      <p class="hero__claim">
        {
          site.claim.map((w, i) => (
            <span class="hero__m">
              <span class="hero__m1">{w.slice(0, 1)}</span>{w.slice(1)}
              {i < site.claim.length - 1 && <span class="sr-only"> · </span>}
            </span>
          ))
        }
      </p>
      <div class="hero__ctas">
        <a href={tel} class="btn btn--ticket hero__call">
          <span>Chiama<span class="hero__num"> {site.telefono}</span></span>
          <span class="btn__stub" aria-hidden="true">
            <svg class="btn__icon" viewBox="0 0 24 24"><path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
          </span>
        </a>
        <a href={`https://wa.me/${site.whatsapp}`} class="btn btn--ghost hero__chat" target="_blank" rel="noopener" aria-label="Scrivimi su WhatsApp">
          <svg class="hero__chat-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5 5.3 15A8 8 0 1 1 9 18.7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          <span class="hero__chat-label">WhatsApp</span>
        </a>
        <a href="#prenota" class="btn btn--ghost hero__book">Richiedi un preventivo</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';
  if (!reducedMotion()) {
    gsap.from('.hero__media', { scale: 1.08, opacity: 0, duration: 1.8, ease: 'expo.out' });
    gsap.from('.hero__text > *', { y: 24, opacity: 0, duration: 1.2, ease: 'expo.out', stagger: 0.08, delay: 0.3 });
  }
</script>

<style>
  .act--hero { padding: 0; }
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    background: var(--void);
    box-shadow: none;
    border-radius: 0;
    overflow: hidden;
  }
  /* Phones first: the portrait fills the screen, the words sit on it at the bottom */
  .hero__media { position: absolute; inset: 0; margin: 0; }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--void) 8%, rgba(5, 5, 5, 0.75) 38%, rgba(5, 5, 5, 0) 70%);
  }
  .hero__video { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.06); }
  .hero__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 0 var(--gutter) calc(40px + env(safe-area-inset-bottom));
  }
  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 15.5vw, 11rem);
    font-weight: 200;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  /* The three words stacked, large, like a bill of the evening */
  .hero__claim {
    display: grid;
    margin: var(--s-3) 0 var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 9vw, 2.6rem);
    font-weight: 500;
    font-stretch: 115%;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .hero__m1 { color: var(--red); }
  .hero__num { display: none; }
  /* Phones: the red ticket takes the row, WhatsApp sits beside it as a square key */
  .hero__ctas { display: flex; gap: 8px; }
  .hero__ctas .btn--ticket { flex: 1; justify-content: space-between; }
  .hero__chat { flex: none; width: 56px; padding: 0; border-radius: 16px; }
  .hero__chat-icon { width: 22px; height: 22px; }
  .hero__chat-label { display: none; }
  .hero__book { display: none; }

  @media (min-width: 900px) {
    .hero__media { left: auto; width: 50%; }
    .hero__media::after { background: linear-gradient(to right, var(--void) 0%, rgba(5, 5, 5, 0) 35%); }
    .hero__text { top: 0; right: 50%; display: flex; flex-direction: column; justify-content: center; padding: var(--nav-h) var(--gutter) 0; }
    .hero__name { font-size: clamp(4rem, 9vw, 9rem); }
    .hero__claim { font-size: clamp(2.2rem, 3.4vw, 3.4rem); }
    .hero__num { display: inline; }
    .hero__ctas { flex-wrap: wrap; gap: 12px; }
    .hero__ctas .btn--ticket { flex: none; }
    .hero__chat { width: auto; padding: 0 1.9em; border-radius: var(--r-pill); }
    .hero__chat-icon { display: none; }
    .hero__chat-label { display: inline; }
    .hero__book { display: inline-flex; }
  }
</style>
