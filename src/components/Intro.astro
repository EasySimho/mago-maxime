---
import site from '../data/site.json';
import Act from './Act.astro';
import Photo from './Photo.astro';
import Signature from './Signature.astro';

// "Tu credi nella magia?" -> the last word set light italic, the question mark a red pip
const words = site.domanda.replace(/\?\s*$/, '').split(' ');
const last = words.pop();
// Words he wrote in capitals (MERAVIGLIA, RICORDO INDELEBILE…) are the ones that carry the sentence
const parts = site.intro.split(/(\b[A-ZÀ-Ý]{3,}(?:\s+[A-ZÀ-Ý]{3,})*\b)/);
---

<Act id="io" tone="chalk">
  <div class="io">
    <div class="io__text">
      <h2 class="title" id="io-title">{words.join(' ')} <em>{last}</em><span class="pip">?</span></h2>
      <p class="io__lead">{parts.map((t, i) => (i % 2 ? <strong>{t.toLowerCase()}</strong> : t))}</p>
    </div>
    <div class="io__side">
      <figure class="io__photo" data-deal>
        <Photo name="mani" alt={`Le mani di ${site.nome} che mostrano una carta dal mazzo`} />
      </figure>
      <p class="io__p">{site.serata}</p>
      <Signature class="io__sig" />
    </div>
  </div>

  <blockquote class="io__quote">
    <p>{site.citazione}</p>
    <footer class="label">{site.nome}</footer>
  </blockquote>
</Act>

<style>
  .io { display: grid; gap: var(--s-6); }
  .io__text .title { margin-bottom: var(--s-4); }
  .io__lead { margin: 0; max-width: 34ch; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.5; }
  /* his capitals, kept as capitals but set as a quiet weight change rather than shouting */
  .io__lead strong { font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.86em; }
  .io__photo { margin: 0; aspect-ratio: 4 / 5; border-radius: var(--r-card); overflow: hidden; rotate: 2deg; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.5); }
  .io__p { margin: var(--s-4) 0 0; font-size: var(--t-lead); line-height: 1.6; max-width: 38ch; color: var(--ash-ink); }
  :global(.io__sig) { margin-top: var(--s-4); }
  .io__quote { margin: clamp(96px, 14vw, 180px) 0 0; }
  .io__quote p {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 3rem);
    font-weight: 350;
    font-style: italic;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .io__quote p::before { content: '“'; }
  .io__quote p::after { content: '”'; }
  .io__quote footer { margin-top: var(--s-3); color: var(--ash-ink); }
  .io__quote footer::before { content: '— '; }

  @media (min-width: 900px) {
    .io { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; gap: clamp(48px, 7vw, 120px); }
  }
</style>
