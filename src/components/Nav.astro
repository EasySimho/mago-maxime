---
import Firma from './Firma.astro';
import site from '../data/site.json';
import { ACTS } from '../data/acts';
import { url } from '../scripts/url';
---

<!-- Logo and controls sit on their own dark capsules, so they hold contrast over any act -->
<header class="nav" data-nav>
  <a href={url()} class="nav__logo" aria-label="Mago Maxime, home" data-logo>
    <Firma class="nav__firma" />
  </a>
  <div class="nav__actions">
    <a href="#prenota" class="btn btn--ticket nav__cta is-hidden" data-nav-cta inert>
      Prenota
      <span class="btn__stub" aria-hidden="true">
        <svg class="btn__icon" viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
      </span>
    </a>
    <button class="nav__toggle" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span data-nav-label>Menu</span>
      <span class="nav__burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<!-- The menu is the stage curtain: it closes over the page, and opens again on the scene you pick -->
<div class="menu" id="nav-menu" data-menu inert>
  <div class="menu__curtain menu__curtain--l" aria-hidden="true"></div>
  <div class="menu__curtain menu__curtain--r" aria-hidden="true"></div>
  <div class="menu__stage">
    <div class="menu__firma"><Firma label="Maxime" /></div>
    <nav aria-label="Principale">
      <ol class="menu__acts">
        {
          ACTS.map((a) => (
            <li>
              <a href={`#${a.id}`}>{a.name}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__foot">
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
    </div>
  </div>
</div>

<script>
  import { lockScroll, getLenis } from '../scripts/motion';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const label = nav.querySelector<HTMLElement>('[data-nav-label]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const isOpen = () => document.documentElement.classList.contains('menu-open');
  const setOpen = (open: boolean) => {
    document.documentElement.classList.toggle('menu-open', open);
    menu.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Chiudi' : 'Menu';
    lockScroll(open);
    if (open) menu.querySelector<HTMLElement>('.menu__acts a')?.focus({ preventScroll: true });
  };
  toggle.addEventListener('click', () => setOpen(!isOpen()));

  const logo = nav.querySelector<HTMLElement>('[data-logo]')!;

  // The hero has its own Prenota: the nav ticket arrives only once the hero has gone
  const cta = nav.querySelector<HTMLElement>('[data-nav-cta]')!;
  // (the hero is a sticky panel that stays under the others, so measure how far the page has scrolled past it)
  const hero = document.querySelector<HTMLElement>('#sipario');
  const phone = matchMedia('(max-width: 760px)');
  const syncCta = () => {
    const on = !hero || scrollY > hero.offsetHeight * 0.85;
    cta.classList.toggle('is-hidden', !on);
    cta.inert = !on;
    // phones: past the hero the signature leaves the corner (it lives on the curtain in the menu)
    const away = on && phone.matches;
    logo.classList.toggle('is-away', away);
    logo.inert = away;
  };
  addEventListener('scroll', syncCta, { passive: true });
  phone.addEventListener('change', syncCta);
  syncCta();

  // The signature has no capsule: it is written in ink over chalk panels, in chalk over the dark
  // Is the first painted background under this point a light one?
  const isLight = (el: Element | null) => {
    for (; el; el = el.parentElement) {
      const [r, g, b, a = 1] = (getComputedStyle(el).backgroundColor.match(/[\d.]+/g) ?? []).map(Number);
      if (a > 0.5) return 0.2126 * r + 0.7152 * g + 0.0722 * b > 140;
    }
    return false;
  };
  let queued = false;
  const tone = () => {
    queued = false;
    const r = logo.getBoundingClientRect();
    logo.style.visibility = 'hidden';
    const under = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
    logo.style.visibility = '';
    logo.classList.toggle('on-chalk', !isOpen() && isLight(under));
  };
  const queue = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(tone);
  };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  new MutationObserver(queue).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  tone();
  // Pick a scene: the page moves behind the closed curtain, then the curtain opens on it
  menu.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => {
      setOpen(false);
      const target = document.querySelector<HTMLElement>(a.hash);
      if (!target) return;
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(target, { immediate: true, force: true });
      else target.scrollIntoView();
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 200;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(16px, 2.4vw, 32px);
    color: var(--chalk);
    pointer-events: none;
  }
  .nav > * { pointer-events: auto; }
  .nav__toggle {
    background: var(--void);
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 6px;
    margin: 12px 0 0 -6px;
    color: var(--chalk);
    text-decoration: none;
    /* a halo the colour of the ground knocks out whatever scrolls beneath the strokes */
    filter: drop-shadow(0 0 3px rgba(5, 5, 5, 0.9)) drop-shadow(0 0 12px rgba(5, 5, 5, 0.7));
    transition: color var(--d-2) var(--ease-out), filter var(--d-2), opacity var(--d-2) var(--ease-out), translate var(--d-2) var(--ease-out);
  }
  .nav__logo:global(.is-away),
  :global(.menu-open) .nav__logo { opacity: 0; translate: 0 -12px; pointer-events: none; }
  .nav__logo:global(.on-chalk) { color: var(--ink); filter: drop-shadow(0 0 3px var(--chalk)) drop-shadow(0 0 10px var(--chalk)); }
  .nav__logo :global(.nav__firma) { width: clamp(118px, 11vw, 150px); }
  /* the name is signed as the page opens */
  @media (prefers-reduced-motion: no-preference) {
    .nav__logo :global(.nav__firma) { animation: sign 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.4s both; }
  }
  @keyframes sign {
    from { clip-path: inset(-20% 100% -20% 0); }
    to { clip-path: inset(-20% 0 -20% 0); }
  }
  .nav__actions { display: flex; align-items: center; gap: 8px; }
  .nav__cta { min-height: 44px; font-size: 0.72rem; }
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(239, 236, 230, 0.28);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--d-1);
  }
  .nav__toggle:hover { border-color: var(--chalk); }
  .nav__burger { display: grid; gap: 5px; width: 16px; }
  .nav__burger span { height: 1px; background: currentColor; transition: transform var(--d-2) var(--ease-out); }
  :global(.menu-open) .nav__burger span:first-child { transform: translateY(3px) rotate(45deg); }
  :global(.menu-open) .nav__burger span:last-child { transform: translateY(-3px) rotate(-45deg); }

  /* ---------- The curtain ---------- */
  .menu {
    --velvet: #6e0a19;
    /* drapes close in fast and settle (ease-out); they part slowly, then whip away (ease-in) */
    --in: 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    --out: 0.65s cubic-bezier(0.7, 0, 0.84, 0);
    position: fixed;
    inset: 0;
    z-index: 199;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    transition: visibility 0s 0.85s;
  }
  :global(.menu-open) .menu { visibility: visible; pointer-events: auto; transition-delay: 0s; }

  /* Two velvet drapes: vertical folds, shadow in the creases, light falling from above */
  .menu__curtain {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 51%;
    background:
      radial-gradient(120% 60% at 50% -10%, rgba(255, 240, 230, 0.16), transparent 60%),
      linear-gradient(to bottom, transparent 70%, rgba(0, 0, 0, 0.45)),
      repeating-linear-gradient(90deg, #3a0510 0, #5e0917 14px, #8e1225 30px, #a3162b 36px, #7a0e1f 48px, #3a0510 64px);
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
    transition: transform var(--out) 0.15s;
    will-change: transform;
  }
  .menu__curtain--l { left: 0; transform-origin: left center; transform: translateX(-100%) scaleX(0.45); }
  .menu__curtain--r { right: 0; transform-origin: right center; transform: translateX(100%) scaleX(0.45); }
  /* where the two drapes meet, the fold falls into shadow */
  .menu__curtain--l::after,
  .menu__curtain--r::after { content: ''; position: absolute; top: 0; bottom: 0; width: 18%; }
  .menu__curtain--l::after { right: 0; background: linear-gradient(to left, rgba(0, 0, 0, 0.45), transparent); }
  .menu__curtain--r::after { left: 0; background: linear-gradient(to right, rgba(0, 0, 0, 0.45), transparent); }
  :global(.menu-open) .menu__curtain { transform: none; transition: transform var(--in); }

  /* What is written on the closed curtain */
  .menu__stage {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    overflow-y: auto;
    padding: calc(var(--nav-h) + 24px) var(--gutter) calc(32px + env(safe-area-inset-bottom));
    text-align: center;
    color: var(--chalk);
    opacity: 0;
    translate: 0 16px;
    transition: opacity 0.15s ease, translate 0.15s ease;
  }
  :global(.menu-open) .menu__stage { opacity: 1; translate: 0 0; transition: opacity 0.5s var(--ease-out) 0.35s, translate 0.6s var(--ease-out) 0.35s; }
  .menu__firma { display: block; color: var(--chalk); filter: drop-shadow(0 2px 14px rgba(0, 0, 0, 0.45)); }
  .menu__firma :global(.firma) { width: clamp(170px, 42vw, 260px); }
  .menu__acts { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.1em; }
  .menu__acts a {
    display: inline-block;
    padding: 0.08em 0.2em;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, min(8vw, 7vh), 4.6rem);
    font-weight: 500;
    white-space: nowrap;
    font-stretch: 112%;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
    transition: font-weight var(--d-2) var(--ease-out);
  }
  .menu__acts a:hover { font-style: italic; font-weight: 250; }
  .menu__foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; }
  .menu__foot a { min-height: 44px; display: inline-flex; align-items: center; color: rgba(239, 236, 230, 0.82); text-decoration: none; font-size: var(--t-small); }
  .menu__foot a:hover { color: var(--chalk); text-decoration: underline; }

  /* The red ticket would vanish into red velvet: the menu already lists Prenota */
  .nav__cta { transition: opacity var(--d-2) var(--ease-out), translate var(--d-2) var(--ease-out); }
  .nav__cta:global(.is-hidden) { opacity: 0; translate: 0 -12px; pointer-events: none; }
  :global(.menu-open) .nav__cta { opacity: 0; pointer-events: none; }

  @media (max-width: 560px) {
    .nav__cta { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__curtain { transform: none !important; transition: none !important; }
    .menu { opacity: 0; transition: opacity 0.3s linear, visibility 0s 0.3s; }
    :global(.menu-open) .menu { opacity: 1; transition: opacity 0.3s linear; }
    .menu__stage,
    :global(.menu-open) .menu__stage { translate: none; transition: opacity 0.3s linear; }
  }
</style>
