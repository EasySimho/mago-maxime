---
/** Maxime's handwritten signature from public/maxime/firma.(svg|png); typed fallback until it arrives. */
import fs from 'node:fs';
import path from 'node:path';
import site from '../data/site.json';
import Firma from './Firma.astro';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const dir = path.join(process.cwd(), 'public', 'maxime');
const file = ['svg', 'png', 'webp'].map((ext) => `firma.${ext}`).find((f) => fs.existsSync(path.join(dir, f)));
import { url } from '../scripts/url';
---

{
  file ? (
    <img class:list={['sig', 'sig--img', cls]} src={url(`maxime/${file}`)} alt={`Firma di ${site.nome}`} />
  ) : (
    <Firma class={`sig sig--firma ${cls}`} label={`Firma di ${site.nome}`} />
  )
}

<style>
  .sig { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 250; font-stretch: 100%; font-size: 2.6rem; line-height: 1; letter-spacing: -0.02em; }
  .sig--img { height: 72px; width: auto; }
  :global(.sig--firma) { width: 170px; }
  :global(.tone-dark) .sig--img { filter: invert(1); }
</style>
